[
  {
    "label": "Studio: Docker Compose up (build)",
    "command": "test -n \"$NODE_AUTH_TOKEN\" || { echo 'Set NODE_AUTH_TOKEN before starting Zed'; exit 1; }; docker compose up --build",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Studio: Docker Compose down",
    "command": "docker compose down",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Studio: Docker Compose logs",
    "command": "docker compose logs --follow",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "Studio: Docker Compose status",
    "command": "docker compose ps",
    "use_new_terminal": true,
    "reveal": "always"
  }
]
